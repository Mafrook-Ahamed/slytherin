# EduForge AI API - local environment configuration
#
# Copy this file to `.env` and adjust the values.
# `.env` is git-ignored and must never contain real secrets.

# --- Application identity ---
APP_NAME=EduForge AI API
APP_VERSION=1.0.0

# development | test | staging | production
ENVIRONMENT=development
DEBUG=true

# --- Logging ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# --- API ---
API_PREFIX=/api/v1
DOCS_ENABLED=true

# --- CORS ---
# Comma separated list of allowed origins. Never use "*" in production:
# it would let any website call the API with the user's credentials.
#
# Notes for Flutter:
#   Android emulator -> host machine is reachable at http://10.0.2.2:8000
#   Android device   -> use your machine's LAN IP, e.g. http://192.168.1.5:8000
#   Flutter web      -> the dev server origin, e.g. http://localhost:xxxxx
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000,http://10.0.2.2:8000

# Must be false if CORS_ORIGINS contains "*".
CORS_ALLOW_CREDENTIALS=true
